# Backend Environment
BACKEND_PORT=3001
BACKEND_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/desa_digital
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRATION=7d
NODE_ENV=development

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=Sistem Informasi Desa Digital
NEXT_PUBLIC_APP_VERSION=1.0.0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=desa_digital
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@desajagaraga.id

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=desa-digital-uploads

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry (Optional)
SENTRY_DSN=

# WhatsApp Gateway (Optional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
